# ============================================================
#  CookLens Environment Configuration
# ============================================================
#
# HOW TO SET UP YOUR GEMINI API KEY
# ----------------------------------
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with your Google account (it's free)
# 3. Click "Create API key" and copy it
# 4. Paste it below after GEMINI_API_KEY=
#
# That's it — no credit card required for the free tier.
# ============================================================

# ── Google Gemini API ─────────────────────────────────────────
GEMINI_API_KEY=AIzaSyCAThtnTCbkha0hmeiwe5do7b_n5ARJ_II

# Gemini OpenAI-compatible endpoint — do not change
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model options:
#   gemini-2.0-flash       → fast, cheap, great for most dishes   ← recommended
#   gemini-1.5-pro         → slower, higher accuracy for edge cases
#   gemini-1.5-flash       → balanced speed/accuracy
AI_MODEL=gemini-2.0-flash

# ── Mock Mode ─────────────────────────────────────────────────
# Set to true to use built-in mock data (no API key needed — for UI demos only)
# Set to false (default) to use real Gemini vision inference
USE_MOCK_DATA=false

# ── Server ────────────────────────────────────────────────────
BACKEND_PORT=8000

# ── Frontend (set in frontend/.env.local, not here) ──────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_USE_MOCK=false
